{
  "author": "Adrien Lacourpaille",
  "devDependencies": {
    "@adrienlcp/biome-config": "^0.3.0",
    "@adrienlcp/tsconfig": "^0.1.1",
    "@biomejs/biome": "2.6.4",
    "@cspell/dict-fr-fr": "^2.3.2",
    "@lhci/cli": "^0.16.0",
    "@playwright/test": "^1.64.1",
    "@types/node": "^26.6.6",
    "@vitest/coverage-v8": "5.1.0",
    "cspell": "^10.4.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  },
  "engines": {
    "node": ">=26.0.0",
    "pnpm": ">=12.0.0"
  },
  "license": "AGPL-3.0-or-later",
  "name": "melee",
  "packageManager": "pnpm@12.16.1+sha512.091d1dee7927575661b25dab3c2ae31cafc1c54d6b71ed6a6600cf0c1cb10434a447eae14015f1b23e2e6bedeed79df94a932e2164d2832280dce3fb32f656d1",
  "private": true,
  "scripts": {
    "build": "pnpm -r build",
    "deps:upgrade": "corepack use pnpm@latest && pnpm -r up -L && biome migrate --write",
    "dev": "pnpm --parallel --filter @melee/server --filter @melee/game dev",
    "lighthouse": "pnpm build && node --import tsx scripts/lighthouse.ts",
    "lint": "biome check --write",
    "lint:ci": "biome ci",
    "prepare": "git config core.hooksPath .githooks",
    "spell": "cspell --no-progress --gitignore \"**\"",
    "test": "pnpm --filter @melee/protocol --filter @melee/core --filter @melee/server --filter @melee/game test",
    "test:core:watch": "pnpm --filter @melee/core test:watch",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "tsc --noEmit -p e2e && playwright test -c e2e",
    "typecheck": "pnpm -r --parallel exec tsc --noEmit && tsc --noEmit -p e2e && tsc --noEmit -p tsconfig.root.json",
    "validate": "pnpm lint:ci && pnpm spell && pnpm build && pnpm typecheck && pnpm test:coverage && pnpm test:e2e"
  },
  "type": "module",
  "version": "0.1.0"
}
