{
  "dependencies": {
    "@adrienlcp/result": "^0.1.1",
    "@hono/zod-validator": "^0.9.1",
    "@melee/core": "workspace:*",
    "@melee/protocol": "workspace:*",
    "d3-geo": "^3.1.2",
    "hono": "^4.13.16",
    "nanoid": "^6.0.2",
    "topojson-client": "^3.1.0",
    "world-atlas": "^2.0.2",
    "zod": "^4.6.7"
  },
  "description": "Authoritative game server for the blind test",
  "devDependencies": {
    "@hono/node-server": "^2.1.6",
    "@melee/game": "workspace:*",
    "@types/d3-geo": "^3.1.1",
    "@types/node": "^26.6.6",
    "@types/topojson-client": "^3.1.5",
    "@types/topojson-specification": "^1.0.5",
    "@types/ws": "^8.18.2",
    "@vitest/coverage-v8": "5.1.0",
    "flag-icons": "7.6.0",
    "hyparquet": "^1.32.0",
    "tsx": "^4.23.15",
    "vitest": "^5.1.0",
    "wrangler": "^4.157.0",
    "ws": "^8.22.1"
  },
  "name": "@melee/server",
  "private": true,
  "scripts": {
    "blacksquare:build": "node --import tsx scripts/build-black-square-bank.ts",
    "build": "wrangler types && tsc --noEmit && tsc --noEmit -p tsconfig.worker.json && wrangler deploy --dry-run --outdir dist",
    "capitals:build": "node --import tsx scripts/build-capital-bank.ts",
    "deploy": "wrangler deploy",
    "dev": "wrangler dev",
    "flags:build": "node --import tsx scripts/build-flag-bank.ts",
    "quantities:build": "node --import tsx scripts/build-quantity-bank.ts",
    "questions:build": "node --import tsx scripts/build-question-bank.ts",
    "silhouettes:build": "node --import tsx scripts/build-silhouette-bank.ts",
    "test": "vitest run",
    "test:watch": "vitest --watch",
    "words:build": "node --import tsx scripts/build-word-bank.ts"
  },
  "type": "module",
  "version": "0.1.0"
}
