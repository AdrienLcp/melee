// The Worker that served the game while it was called Taverla, kept under its
// old name because the old domain is attached to it. Deployed by hand, once:
// `pnpm exec wrangler deploy -c former-host/wrangler.jsonc` from `apps/server`.
{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "compatibility_date": "2026-09-01",
  "main": "worker.ts",
  // A Worker that once held Durable Objects has to say it drops them.
  "migrations": [
    { "new_sqlite_classes": ["RoomObject", "WallPairingObject"], "tag": "v1" },
    { "deleted_classes": ["RoomObject", "WallPairingObject"], "tag": "v2" }
  ],
  "name": "taverla",
  "routes": [{ "custom_domain": true, "pattern": "taverla.adrienlcp.com" }],
  "workers_dev": false
}
