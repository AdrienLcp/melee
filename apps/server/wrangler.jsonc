{
  "$schema": "node_modules/wrangler/config-schema.json",
  "assets": {
    "binding": "ASSETS",
    "directory": "../game/dist",
    "not_found_handling": "single-page-application",
    "run_worker_first": [
      "/api/*",
      "/assets/*",
      "/mcp",
      "/ws/*",
      "/robots.txt",
      "/sitemap.xml"
    ]
  },
  "compatibility_date": "2026-11-05",
  // `process.env` is how `env.ts` reads its variables on both runtimes.
  "compatibility_flags": ["nodejs_compat"],
  // Offset from 8787 like the app from 5173: this repo runs beside the other
  // dev servers on the machine, and Vite proxies `/api` and `/ws` here.
  "dev": {
    "port": 3100
  },
  "durable_objects": {
    "bindings": [
      { "class_name": "RoomObject", "name": "ROOMS" },
      { "class_name": "WallPairingObject", "name": "WALL_PAIRINGS" }
    ]
  },
  // `wrangler deploy --env staging`: a Worker of its own, `melee-staging`,
  // whose rooms live in Durable Objects of their own — a test evening never
  // reaches a room on a real table. Bindings, vars and routes are not
  // inherited, so each is declared again.
  "env": {
    "staging": {
      "durable_objects": {
        "bindings": [
          { "class_name": "RoomObject", "name": "ROOMS" },
          { "class_name": "WallPairingObject", "name": "WALL_PAIRINGS" }
        ]
      },
      "ratelimits": [
        {
          "name": "ROOM_CREATION_LIMITER",
          "namespace_id": "1002",
          "simple": { "limit": 10, "period": 60 }
        }
      ],
      "routes": [
        { "custom_domain": true, "pattern": "staging.melee.adrienlcp.com" }
      ],
      "vars": { "INDEXABLE": "false" }
    }
  },
  "main": "src/worker.ts",
  // The free plan only offers Durable Objects backed by SQLite.
  "migrations": [
    { "new_sqlite_classes": ["RoomObject", "WallPairingObject"], "tag": "v1" }
  ],
  "name": "melee",
  "observability": { "enabled": true },
  "ratelimits": [
    {
      "name": "ROOM_CREATION_LIMITER",
      "namespace_id": "1001",
      "simple": { "limit": 10, "period": 60 }
    }
  ],
  // Declared here so a deploy keeps the custom domain attached rather than
  // detaching what was set up outside this file.
  "routes": [{ "custom_domain": true, "pattern": "melee.adrienlcp.com" }],
  // The workers.dev address was never shared: the game is only served at its
  // own domain.
  "workers_dev": false
}
